{
  "name": "roc-playground",
  "version": "0.0.0",
  "description": "Interactive Roc Playground",
  "source": "src/index.html",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "fetch-wasm": "bash scripts/fetch-wasm.sh",
    "setup": "npm ci && npm run fetch-wasm",
    "dev": "parcel serve src/index.html --port 8000",
    "build": "parcel build src/index.html --public-url ./",
    "clean": "rm -rf dist .parcel-cache",
    "preview": "parcel serve dist/index.html --port 8001",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-wasm.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@parcel/optimizer-cssnano": "^2.16.4",
    "@parcel/optimizer-terser": "^2.16.4",
    "@parcel/transformer-raw": "^2.16.4",
    "@types/node": "^24.19.2",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "typescript": "^7.0.2",
    "util": "^0.12.5"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
